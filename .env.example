# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here
# A model you have access to that supports tool calling
OPENAI_MODEL=your-tool-calling-model
# Optional cheaper model for the Intake and Verifier agents (leave empty to use OPENAI_MODEL)
OPENAI_MODEL_LIGHT=
LLM_TEMPERATURE=0.4
MAX_DEBATE_ROUNDS=3
AGENT_MAX_STEPS=8
